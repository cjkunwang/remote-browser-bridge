{
  "manifest_version": 3,
  "name": "Remote Browser Bridge",
  "version": "0.2.1",
  "description": "Connect an authorized Chrome profile to a private remote browser control server.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Remote Browser Bridge",
    "default_popup": "popup.html"
  }
}
